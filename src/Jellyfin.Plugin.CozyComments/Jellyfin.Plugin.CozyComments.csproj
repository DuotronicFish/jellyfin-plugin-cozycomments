<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.CozyComments</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.CozyComments</AssemblyName>
    <Version>2.0.1.0</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Ship only our own dll: Jellyfin, Newtonsoft.Json and Microsoft.Data.Sqlite come from the server itself. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Jellyfin 12.x (net10.0). Built against 12.0.0 so every 12.x server can load it (targetAbi 12.0.0.0).
         Override with -p:JellyfinVersion=12.N.0 to compile against a later 12.x release.
         The Jellyfin 10.11 build is version 1.2.2.0 (jellyfin-10.11 branch / git tag v1.2.2.0). -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Keep this at 10.0.0. The server supplies Microsoft.Data.Sqlite and .NET will not load a plugin that asks for a
         newer version than the server has (Jellyfin 12.0-12.2 ship 10.0.11, 12.3 ships 10.0.12, 12.4 ships 10.0.14).
         Asking for 10.0.0 works on every 12.x server. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\client.js" />
    <EmbeddedResource Include="Web\client.css" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
